# What belongs in the repo is what describes the PROJECT. What belongs on your
# machine is what describes YOUR machine: models, caches, logs, credentials,
# session memory, your voice. The split is deliberate — CLAUDE.md, AGENTS.md,
# README.md, TODO.md and TODONT.md are all tracked on purpose, because they say
# how the project works and why. Nothing below does.

# --- models (huge, and yours) ----------------------------------------------
model/
gpu-model/
npu-model/
models/

# --- Python environments ---------------------------------------------------
venv/
venv-2026.3/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# --- generated at run time, never source ------------------------------------
# The OpenVINO compiled-model cache: regenerated on demand, hundreds of MB.
.ov-cache/
# Prewarm captures. The auto-named form is prewarm-<port>.json, so glob it.
prewarm.json
prewarm-*.json
# Search indexes and benchmark output.
bench-results/
*.log
scripts/.watch_title
scripts/.watch_body.md

# --- machine-local configuration --------------------------------------------
# start.ps1 is generated by install.ps1 with this machine's paths baked in;
# start-template.ps1 is the tracked source it is generated FROM.
start.ps1
# Absolute paths baked in — regenerate with scripts/locally-launch.ps1.
locally.lnk
# Runtime settings for this install. locally.ini.example is tracked instead.
locally.ini
keys.ini
# The guided-setup result. Normally written to %LOCALAPPDATA%/locally, but
# LOCALLY_SETUP_CONFIG can put it here.
setup.json

# --- secrets ----------------------------------------------------------------
.env
*.env
*.pem
*.key
id_rsa*

# --- personal ---------------------------------------------------------------
# Enrolled voice profile. This is biometric data and must never be public.
odysseus-autostart.json
speaker-profile.json
# Assistant session memory, local tool settings, and delegated worktrees.
# Distinct from CLAUDE.md / AGENTS.md at the repo root, which ARE tracked:
# those describe the project, this describes a machine and a conversation.
.claude/
# Local planning notes, not reviewed and not part of the design record.
plans/

# Measurement scratch: probe output, screenshots, regenerated sheets.
scratchpad/
